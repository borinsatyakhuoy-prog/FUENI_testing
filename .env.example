# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Staging - new version (focus of current testing, per user-stories/SCRUM.md)
FUENI_BASE_URL=https://fueni-staging-preview-patient.allweb.cloud
# Old/stable staging version - used as a before/after reference when comparing
# pre-fix vs post-fix behavior.
FUENI_OLD_BASE_URL=https://fueni-staging-patient.allweb.cloud

# Patient-role test account credentials (see user-stories/SCRUM.md). This is a single
# shared account, not a synthetic-per-test one - tests must not mutate it for real
# (password/email/phone/profile changes) - see the AC "Error Handling" real-data-safety note.
FUENI_EMAIL=your-test-account-email@example.com
FUENI_PASSWORD=your-test-account-password
# National-part-only phone number (no country code) for the same shared account,
# as shown under Connexion & Sécurité - used only by the phone/password login test.
FUENI_PHONE_NATIONAL=your-test-account-phone-national-part

# Doctor ("Espace professionnel") role test account. Login requires a mandatory
# email-OTP two-factor step on every login - this account's mailbox should be one
# reachable via the temp-mail MCP server so Claude can read the OTP unattended,
# unlike a real personal inbox. KYC review may still be pending - see
# tickets/DOCTOR-ROLE-registration-blocked-by-turnstile for the full context.
FUENI_PRO_BASE_URL=https://fueni-staging-preview-pro.allweb.cloud
FUENI_PRO_EMAIL=your-doctor-test-account-email@example.com
FUENI_PRO_PASSWORD=your-doctor-test-account-password
